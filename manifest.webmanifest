{
  "name": "Life Hub",
  "short_name": "Life Hub",
  "description": "My all-in-one everyday app: travel, workouts and everything else.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0f14",
  "theme_color": "#0d0f14",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ask the assistant",
      "short_name": "Assistant",
      "url": "assistant/",
      "icons": [
        {
          "src": "icons/sc-ai.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "To-do",
      "short_name": "To-do",
      "url": "todo/",
      "icons": [
        {
          "src": "icons/sc-todo.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Next bus (Travel)",
      "short_name": "Travel",
      "url": "travel/",
      "icons": [
        {
          "src": "icons/sc-travel.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Workout",
      "short_name": "Workout",
      "url": "workout/",
      "icons": [
        {
          "src": "icons/sc-workout.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "money/?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/*",
            ".pdf"
          ]
        }
      ]
    }
  }
}
